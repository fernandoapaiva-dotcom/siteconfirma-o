# Copie este arquivo para ".env" e preencha com os seus dados reais.
# NUNCA suba o .env real pro GitHub nem compartilhe publicamente.

# Porta do servidor local
PORT=3001

# Caminho para o arquivo JSON da conta de serviço do Google Cloud
# (veja o passo a passo no README.md para gerar esse arquivo)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# ID da pasta do Google Drive onde as fotos serão salvas
# (pegue da URL da pasta: drive.google.com/drive/folders/ESTE_ID_AQUI)
DRIVE_FOLDER_ID=

# ID da planilha do Google Sheets usada como "banco" de confirmações
# (pegue da URL da planilha: docs.google.com/spreadsheets/d/ESTE_ID_AQUI/edit)
SHEET_ID=

# Nome da aba dentro da planilha (crie essa aba na sua planilha)
SHEET_TAB=Confirmacoes

# Senha para acessar a área da família (/admin no site): ver a lista
# de confirmados e exportar o PDF. Troque por algo só seu.
ADMIN_PASSWORD=troque-esta-senha
